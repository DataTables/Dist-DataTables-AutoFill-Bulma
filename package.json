{
    "name": "datatables.net-autofill-bm",
    "description": "AutoFill for DataTables with styling for [Bulma](https://bulma.io/)",
    "main": "./js/autoFill.bulma.js",
    "module": "./js/autoFill.bulma.mjs",
    "style": "./css/autoFill.bulma.css",
    "types": "./types/autoFill.bulma.d.ts",
    "version": "3.1.1",
    "files": [
        "js",
        "css",
        "types"
    ],
    "keywords": [
        "AutoFill",
        "Excel",
        "Bulma",
        "Datatables",
        "table",
        "filter",
        "sort"
    ],
    "dependencies": {
        "datatables.net-autofill": "3.1.1",
        "datatables.net-bm": "^3.1"
    },
    "author": {
        "name": "SpryMedia Ltd",
        "url": "http://datatables.net"
    },
    "homepage": "https://datatables.net",
    "bugs": "https://datatables.net/forums",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DataTables/AutoFill.git"
    },
    "exports": {
        ".": {
            "types": "./types/autoFill.bulma.d.ts",
            "style": "./css/autoFill.bulma.css",
            "import": "./js/autoFill.bulma.mjs",
            "require": "./js/autoFill.bulma.js",
            "default": "./js/autoFill.bulma.mjs"
        },
        "./js/*": "./js/*",
        "./css": {
            "types": "./types/css.d.ts",
            "default": "./css/autoFill.bulma.css"
        },
        "./css/*": {
            "types": "./types/css.d.ts",
            "default": "./css/*"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": true
}